{
  "name": "turkiye-adres",
  "version": "0.1.0",
  "description": "Türkiye il, ilçe, mahalle/köy ve posta kodu sorguları: bağımlılıksız kütüphane + PTT'den kendi verinizi üreten betikler.",
  "type": "module",
  "license": "MIT",
  "author": "Hamza Sarıkaya",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./browser": { "types": "./src/browser.d.ts", "default": "./src/browser.js" },
    "./data/provinces.json": "./data/provinces.json"
  },
  "files": ["src", "scripts", "data/provinces.json", "examples", "README.md", "LICENSE", "THIRD-PARTY.md"],
  "scripts": {
    "fetch": "node scripts/fetch-ptt.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "engines": { "node": ">=20" },
  "keywords": ["turkiye", "turkey", "turkish", "il", "ilce", "mahalle", "koy", "posta-kodu", "postal-code", "zip-code", "adres", "address", "provinces", "districts", "neighborhoods", "ptt"],
  "repository": { "type": "git", "url": "git+https://github.com/HamzaSarikaya/Turkiye-Il-Ilce-Mahalle-Posta_Kodu.git" },
  "homepage": "https://github.com/HamzaSarikaya/Turkiye-Il-Ilce-Mahalle-Posta_Kodu#readme",
  "bugs": { "url": "https://github.com/HamzaSarikaya/Turkiye-Il-Ilce-Mahalle-Posta_Kodu/issues" }
}
